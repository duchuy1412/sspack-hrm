# Cấu hình local cho SS Pack HRM.
# Sao chép thành infra/.env (đã gitignore) rồi sửa nếu cần:
#   cp infra/.env.example infra/.env
# File này được dùng chung bởi docker compose (infra/) và backend (spring.config.import).
# Chỉ chứa giá trị cho môi trường local; KHÔNG dùng các mật khẩu này ở môi trường thật.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrm
DB_USERNAME=hrm
DB_PASSWORD=hrm

# Kafka (KRaft, 1 node)
KAFKA_PORT=9092

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=hrm

# MinIO (API S3 và console)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hrm-minio
MINIO_ROOT_PASSWORD=hrm-minio-secret

# Mailpit (SMTP và giao diện web)
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
